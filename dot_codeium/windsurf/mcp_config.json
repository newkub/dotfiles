{
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "command": "bunx",
      "disabled": false
    },
    "crw": {
      "args": [
        "crw-mcp"
      ],
      "command": "bunx",
      "disabled": false,
      "env": {
        "CRW_BROWSER_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
      }
    },
    "deepwiki": {
      "registry": "io.windsurf/deepwiki",
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "grep": {
      "disabled": true,
      "url": "https://mcp.grep.app"
    },
    "io.windsurf/cloudflare-docs": {
      "registry": "io.windsurf/cloudflare-docs",
      "serverUrl": "https://docs.mcp.cloudflare.com/mcp"
    },
    "io.windsurf/deepwiki": {
      "registry": "io.windsurf/deepwiki",
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "io.windsurf/github-mcp-server": {
      "registry": "io.windsurf/github-mcp-server",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "lightpanda": {
      "args": [
        "mcp"
      ],
      "command": "/path/to/lightpanda"
    },
    "linear": {
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "command": "bunx",
      "disabled": true
    },
    "mise": {
      "args": [
        "-y"
      ],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      }
    },
    "moon": {
      "command": "moon",
      "disabled": true,
      "env": {
        "MOON_WORKSPACE_ROOT": "/"
      }
    },
    "next-devtools": {
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "command": "bunx",
      "disabled": true
    },
    "nuxt": {
      "args": [
        "mcp"
      ],
      "command": "nuxt",
      "disabled": true
    },
    "raindrop": {
      "command": "bunx",
      "args": [
        "@adeze/raindrop-mcp@latest"
      ],
      "env": {
        "RAINDROP_ACCESS_TOKEN": "${RAINDROP_ACCESS_TOKEN}"
      },
      "disabled": true
    },
    "rust-filesystem": {
      "args": [
        "D:/"
      ],
      "command": "rust-mcp-filesystem",
      "disabled": true
    },
    "ast-grep": {
      "command": "ast-grep-mcp-server",
      "args": [],
      "env": {}
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "bunx",
      "disabled": true
    },
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "vueuse": {
      "args": [
        "vueuse-mcp"
      ],
      "command": "bunx"
    },
    "wezterm": {
      "args": [
        "mcp-server-wezterm-rs"
      ],
      "command": "uvx",
      "disabled": true
    }
  }
}
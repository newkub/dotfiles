{
  "mcpServers": {
    "ast-grep": {
      "command": "ast-grep-mcp-server"
    },
    "chrome-devtools": {
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "command": "bunx",
      "disabled": false
    },
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "crw": {
      "args": [
        "crw-mcp"
      ],
      "command": "bunx",
      "disabled": false,
      "env": {
        "CRW_BROWSER_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
      }
    },
    "deepwiki": {
      "registry": "io.windsurf/deepwiki",
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "devin/cloudflare-docs": {
      "registry": "devin/cloudflare-docs",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "devin/context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@1.0.31"
      ],
      "command": "npx",
      "disabled": true,
      "registry": "devin/context7"
    },
    "devin/deepwiki": {
      "registry": "devin/deepwiki",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "devin/git": {
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/git"
      ],
      "command": "docker",
      "registry": "devin/git"
    },
    "devin/github-mcp-server": {
      "registry": "devin/github-mcp-server",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "io.windsurf/cloudflare-docs": {
      "registry": "io.windsurf/cloudflare-docs",
      "serverUrl": "https://docs.mcp.cloudflare.com/mcp"
    },
    "io.windsurf/deepwiki": {
      "registry": "io.windsurf/deepwiki",
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "io.windsurf/github-mcp-server": {
      "registry": "io.windsurf/github-mcp-server",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "lightpanda": {
      "args": [
        "mcp"
      ],
      "command": "/path/to/lightpanda",
      "disabled": true
    },
    "linear": {
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "command": "bunx",
      "disabled": true
    },
    "mise": {
      "args": [
        "-y"
      ],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      }
    },
    "moon": {
      "command": "moon",
      "disabled": true,
      "env": {
        "MOON_WORKSPACE_ROOT": "/"
      }
    },
    "next-devtools": {
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "command": "bunx",
      "disabled": true
    },
    "nuxt": {
      "args": [
        "mcp"
      ],
      "command": "nuxt",
      "disabled": true
    },
    "raindrop": {
      "args": [
        "@adeze/raindrop-mcp@latest"
      ],
      "command": "bunx",
      "disabled": true,
      "env": {
        "RAINDROP_ACCESS_TOKEN": "${RAINDROP_ACCESS_TOKEN}"
      }
    },
    "rust-filesystem": {
      "args": [
        "D:/"
      ],
      "command": "rust-mcp-filesystem",
      "disabled": true
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "bunx",
      "disabled": true
    },
    "stripe": {
      "url": "https://mcp.stripe.com"
    },
    "supabase": {
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:54321/mcp?read_only=true\u0026features=docs%2Cdatabase%2Cdebugging%2Cdevelopment"
      ],
      "command": "bunx"
    },
    "vueuse": {
      "args": [
        "vueuse-mcp"
      ],
      "command": "bunx"
    },
    "wezterm": {
      "args": [
        "mcp-server-wezterm-rs"
      ],
      "command": "uvx",
      "disabled": true
    }
  }
}
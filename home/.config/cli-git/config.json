{
  "git": {
    "defaultBranch": "main",
    "autoFetch": true,
    "defaultRemote": "origin"
  },
  "commit": {
    "defaultType": "feat",
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "requireScope": false,
    "scopes": []
  },
  "branch": {
    "patterns": {
      "feature": "feature/{ticket}-{description}",
      "bugfix": "bugfix/{ticket}-{description}",
      "hotfix": "hotfix/{ticket}-{description}",
      "release": "release/{version}"
    }
  },
  "ui": {
    "emoji": true,
    "theme": {
      "primaryColor": "#007bff",
      "successColor": "#28a745",
      "warningColor": "#ffc107",
      "errorColor": "#dc3545",
      "infoColor": "#17a2b8"
    }
  }
}
{
  "version": 1,
  "devin": {
    "org_id": "org-4e47413a2c1043578fdefa90049323d0"
  },
  "shell": {
    "setup_complete": true
  },
  "theme_mode": "dark",
  "agent": {
    "model": "swe-2-high",
    "thinking": {}
  },
  "auto_update": true,
  "read_config_from": {
    "windsurf": false,
    "cursor": false,
    "agents_standard": true,
    "claude": false,
    "opencode": false,
    "zed": false
  },
  "show_path": true,
  "notify": "never",
  "mouse_capture": true,
  "unicode_mode": "auto",
  "permissions": {
    "allow": [],
    "deny": [
      "npx"
    ],
    "ask": []
  },
  "show_hints": false,
  "theme_auto_detect": "always",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" activity",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" activity",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(exec|write|edit|multi_edit|apply_patch|notebook_edit|run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" veto",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" veto",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" activity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write|edit|multi_edit|apply_patch|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" post-edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(exec|bash|shell|run_command|command)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" activity",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" loop-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" state-check",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" update-activity",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" activity",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"D:/harness/hooks/bin/harness-hooks.exe\" self-check",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "legacy_terminal": true
}